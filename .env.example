# Copy to .env and fill in your own connection details.
# ssh: connect from your computer (default); local: agent already runs on cluster.
BUPT_SCC_MODE=ssh
# Only required in ssh mode. Leave these empty in local mode.
BUPT_SCC_HOST=
BUPT_SCC_PORT=
BUPT_SCC_USER=
# Optional: path to an existing private key, never the key contents.
BUPT_SCC_IDENTITY=
# Required for Slurm submission; sent as sbatch --comment.
BUPT_SLURM_COMMENT=
# Optional default partition, chosen after checking cluster resources.
BUPT_SLURM_PARTITION=
